# ============================================================================
# Sirius for Agents — root env example
# Copy to .env and fill in. Backend, contracts, and frontend all read from here.
# ============================================================================

# ---- 0G Chain (testnet) ----
# Public testnet info (April 2026 — verify at build.0g.ai):
#   RPC:        https://evmrpc-testnet.0g.ai
#   Chain ID:   16601
#   Explorer:   https://chainscan-galileo.0g.ai
ZEROG_CHAIN_RPC=https://evmrpc-testnet.0g.ai
ZEROG_CHAIN_ID=16601
ZEROG_PRIVATE_KEY=0x...                      # funded testnet account

# ---- 0G Storage ----
ZEROG_STORAGE_RPC=https://indexer-storage-testnet-turbo.0g.ai
ZEROG_STORAGE_API_KEY=

# ---- 0G Compute (sealed inference) ----
ZEROG_COMPUTE_ENDPOINT=
ZEROG_COMPUTE_API_KEY=
ZEROG_COMPUTE_MODEL=qwen3.6-plus

# ---- Mock TEE oracle (ERC-7857 reseal) ----
# Hackathon mock — a known keypair. Replace with real oracle infra in production.
# Default Hardhat account #9 (DO NOT USE ON MAINNET):
ORACLE_ADDRESS=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720
ORACLE_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# ---- Sepolia ENS ----
ENS_RPC=https://eth-sepolia.public.blastapi.io
ENS_PARENT_NAME=                              # e.g. "siriusagents.eth"
ENS_RESOLVER_ADDRESS=
ENS_OWNER_PRIVATE_KEY=0x...

# ---- Backend ----
PORT=3001
DATABASE_URL=file:./sirius.db
JWT_SECRET=change-me-please

# ---- Fallback inference (used when 0G Compute unavailable) ----
ANTHROPIC_API_KEY=

# ---- Deployed addresses (filled in after `deploy:zerog`) ----
AGENT_INFT_ADDRESS=

# ---- Frontend (Vite-prefixed) ----
VITE_BACKEND_URL=http://localhost:3001
VITE_ZEROG_CHAIN_ID=16601
VITE_ZEROG_RPC=https://evmrpc-testnet.0g.ai
VITE_AGENT_INFT_ADDRESS=
VITE_ENS_PARENT=
VITE_WALLETCONNECT_PROJECT_ID=
